---
import '../styles/global.css';

// BaseLayout — global head (SEO meta, canonical, Organization schema)
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}
const {
  title,
  description = "Nanjing Progene Biotechnology — IVD rapid test & POCT OEM/ODM manufacturer. 600+ SKUs, CE-certified, GMP facility in Nanjing.",
  canonical,
} = Astro.props;

const site = "https://nanjingprogene.com";
const url = canonical ? new URL(canonical, site).href : new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta name="twitter:card" content="summary" />
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/" aria-label="Nanjing Progene Biotechnology — home">
        <img
          src="/images/logo-en.png"
          width="3754"
          height="1060"
          alt="Nanjing Progene Biotechnology logo — 南京普诺基生物科技有限公司"
        />
      </a>

      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
      <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation">
        <span></span>
      </label>

      <nav class="main-nav" aria-label="Main navigation">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/products/">Products</a></li>
          <li><a href="/manufacturing/">Manufacturing</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
        <a class="btn btn-accent header-cta" href="/rfq/">Request a Quote</a>
      </nav>
    </div>
  </header>

  <main class="site-main">
    <div class="wrap page">
      <slot />
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div class="footer-brand">
        <img
          src="/images/logo-en.png"
          width="3754"
          height="1060"
          alt="Nanjing Progene Biotechnology logo"
          loading="lazy"
        />
        <p>
          Nanjing Progene Biotechnology Co., Ltd<br />
          南京普诺基生物科技有限公司
        </p>
        <p>IVD rapid test &amp; POCT OEM/ODM manufacturer. GMP facility in Nanjing, China.</p>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <h2>Explore</h2>
        <ul>
          <li><a href="/products/">Product Catalog</a></li>
          <li><a href="/manufacturing/">Manufacturing</a></li>
          <li><a href="/evidence/certifications/">Certifications</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>

      <div class="footer-contact">
        <h2>Contact</h2>
        <p>
          No. 26, Hengguang Road<br />
          Qixia District, Nanjing<br />
          Jiangsu, China
        </p>
        <p><a href="mailto:info@progenebio.com">info@progenebio.com</a></p>
        <p><a href="tel:+862566044660">+86-25-66044660</a></p>
      </div>

      <div class="footer-qr">
        <h2>WhatsApp</h2>
        <img
          src="/images/whatsapp-qr.png"
          width="568"
          height="596"
          alt="Progene Bio WhatsApp QR code"
          loading="lazy"
        />
        <p>Scan to chat about samples, pricing and OEM/ODM.</p>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="wrap">
        <p>© {new Date().getFullYear()} Nanjing Progene Biotechnology Co., Ltd</p>
        <p>IVD rapid tests · POCT · OEM/ODM</p>
      </div>
    </div>
  </footer>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": site + "/#organization",
        "name": "Nanjing Progene Biotechnology Co., Ltd",
        "alternateName": "南京普诺基生物科技有限公司",
        "url": site,
        "email": "info@progenebio.com",
        "telephone": "+86-25-66044660",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "No. 26, Hengguang Road",
          "addressLocality": "Nanjing",
          "addressRegion": "Jiangsu",
          "addressCountry": "CN"
        }
      },
      {
        "@type": "WebSite",
        "@id": site + "/#website",
        "name": "Nanjing Progene Bio",
        "url": site,
        "publisher": { "@id": site + "/#organization" }
      }
    ]
  })} />
</body>
</html>
