        ]
      },
      {
        "@type": "WebSite",
        "@id": site + "/#website",
        "name": "Nanjing Progene Bio",
        "url": site,
        "publisher": { "@id": site + "/#organization" }
      },
      {
        "@type": pageType,
        "@id": pageId,
        "url": url,
        "name": title,
        "description": description,
        "isPartOf": { "@id": site + "/#website" },
        "about": { "@id": site + "/#organization" }
      },
      {
        "@type": "BreadcrumbList",
        "@id": url + "#breadcrumbs",
        "itemListElement": crumbList
      }
    ]
  })} />
</body>
</html>
