---
// BaseLayout — global head (SEO meta, canonical, Organization schema)
interface Props {
  title: string;
  description?: string;
  canonical?: string;
}
const {
  title,
  description = "Nanjing Progene Biotechnology — IVD rapid test & POCT OEM/ODM manufacturer. 600+ SKUs, CE-certified, GMP facility in Nanjing.",
  canonical,
} = Astro.props;

const site = "https://nanjingprogene.com";
const url = canonical ? new URL(canonical, site).href : new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta name="twitter:card" content="summary" />
  <style>
    :root { --navy:#0f1f3d; --amber:#e8a33d; --bg:#f6f8fb; --fg:#1a2233; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; background:var(--bg); color:var(--fg); line-height:1.6; }
    a { color:#1e5aa8; text-decoration:none; }
    a:hover { text-decoration:underline; }
    .wrap { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
    header { background:var(--navy); color:#fff; }
    header .wrap { display:flex; align-items:center; justify-content:space-between; padding:14px 20px; }
    header .brand { color:#fff; font-weight:700; font-size:1.15rem; }
    header nav a { color:#c7d2e0; margin-left:18px; }
    main { min-height: 60vh; padding: 28px 0; }
    footer { background:var(--navy); color:#c7d2e0; padding: 24px 0; font-size:.85rem; }
    table { border-collapse: collapse; width:100%; background:#fff; }
    th, td { border:1px solid #e2e8f0; padding:8px 10px; text-align:left; font-size:.92rem; }
    th { background:#f1f5f9; }
    .card { background:#fff; border:1px solid #e2e8f0; border-radius:8px; padding:16px 18px; margin:12px 0; }
    .pill { display:inline-block; padding:2px 10px; border-radius:999px; font-size:.78rem; font-weight:600; }
    .pill-ce { background:#e6f4ea; color:#1a7f37; }
    .pill-p1 { background:#fef3c7; color:#92400e; }
  </style>
</head>
<body>
  <header>
    <div class="wrap">
      <a class="brand" href="/">Nanjing Progene Bio</a>
      <nav>
        <a href="/products/">Products</a>
        <a href="/solutions/">Solutions</a>
        <a href="/manufacturing/">Manufacturing</a>
        <a href="/rfq/">Request a Quote</a>
      </nav>
    </div>
  </header>
  <main>
    <div class="wrap">
      <slot />
    </div>
  </main>
  <footer>
    <div class="wrap">
      <p>© {new Date().getFullYear()} Nanjing Progene Biotechnology Co., Ltd — IVD rapid test &amp; POCT OEM/ODM manufacturer.</p>
    </div>
  </footer>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": site + "/#organization",
        "name": "Nanjing Progene Biotechnology Co., Ltd",
        "alternateName": "南京普诺基生物科技有限公司",
        "url": site,
        "email": "info@progenebio.com",
        "telephone": "+86-25-66044660",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "No. 26, Hengguang Road",
          "addressLocality": "Nanjing",
          "addressRegion": "Jiangsu",
          "addressCountry": "CN"
        }
      },
      {
        "@type": "WebSite",
        "@id": site + "/#website",
        "name": "Nanjing Progene Bio",
        "url": site,
        "publisher": { "@id": site + "/#organization" }
      }
    ]
  })} />
</body>
</html>
