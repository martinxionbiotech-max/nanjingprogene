---
import '../styles/global.css';

// BaseLayout — global head (SEO meta, canonical, Organization schema)
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  /** schema.org @type for the WebPage node (WebPage / ItemPage / CollectionPage / AboutPage…) */
  pageType?: string;
  /** optional breadcrumb trail below Home, e.g. [{ name: 'Products', href: '/products/' }] */
  breadcrumbs?: { name: string; href: string }[];
  /** label used for the final breadcrumb when it differs from the title */
  crumbName?: string;
}
const {
  title,
  description = "Nanjing Progene Biotechnology — IVD rapid test & POCT OEM/ODM manufacturer. 600+ SKUs, CE-certified, GMP facility in Nanjing.",
  canonical,
  noindex = false,
  pageType = "WebPage",
  breadcrumbs = [],
  crumbName,
} = Astro.props;

const site = "https://progenebio.net";
const url = canonical ? new URL(canonical, site).href : new URL(Astro.url.pathname, site).href;
const pageId = url.replace(/\/+$/, "") + "/#webpage";

// BreadcrumbList: Home → optional intermediate trails → current page
const crumbList: any[] = [
  { "@type": "ListItem", position: 1, name: "Home", item: site + "/" },
  ...breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    position: i + 2,
    name: b.name,
    item: new URL(b.href, site).href,
  })),
];
if (crumbList[crumbList.length - 1].item !== url) {
  crumbList.push({
    "@type": "ListItem",
    position: crumbList.length + 1,
    name: crumbName ?? title.split(" | ")[0].split(" — ")[0],
    item: url,
  });
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={url} />
  <meta name="twitter:card" content="summary" />
