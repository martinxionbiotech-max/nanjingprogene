---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import products from '../../../data/products.json';
import diseaseContent from '../../../data/disease-content.json';
import authorTake from '../../../data/author-take.json';

export function getStaticPaths() {
  return products.hubs.map((h) => ({ params: { slug: h.id }, props: { hub: h } }));
}

const { hub } = Astro.props;
const hubProducts = products.products.filter((p) => hub.products.includes(p.id));
const dc = diseaseContent[hub.id];
const at = authorTake[hub.id];
---

<BaseLayout
  title={`${hub.name} Rapid Tests & Testing Guide | Progene Bio`}
  description={`${hub.name} rapid tests and point-of-care testing guide. Products, methods and specimen types from Progene Bio.`}
  canonical={`/solutions/disease/${hub.id}/`}
>

  <p><a href="/">← Home</a></p>
  <h1>{hub.name}</h1>
  <p>Point-of-care rapid testing for {hub.name.toLowerCase()}. OEM/ODM manufacturer.</p>

  {dc && (
    <>
      <h2>Overview</h2>
      <p>{dc.overview}</p>
      <h2>Diagnostic Methods</h2>
      <p>{dc.methods}</p>
      <h2>Interpretation</h2>
      <p>{dc.interpretation}</p>
    </>
  )}

  {at && (
    <div class="card" style="border-left:4px solid #e8a33d; margin-top:20px;">
      <h2>The Author's Take</h2>
      <p><strong>Position:</strong> {at.position}</p>
      <ul>
        {at.reasoning.map((r) => <li>{r}</li>)}
      </ul>
      <p style="font-size:.82rem;color:#64748b;">{authorTake._disclosure}</p>
    </div>
  )}

  <h2>Products ({hubProducts.length})</h2>
  <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:12px;">
    {hubProducts.map((p) => (
      <a class="card" href={`/products/${p.id}/`} style="display:block;">
        <strong>{p.name}</strong>
        <div style="margin-top:6px; font-size:.85rem; color:#4a5568;">{p.target}</div>
        <div style="margin-top:8px; font-size:.8rem;">
          Specimen: {(p.specimen ?? []).join(" / ")}
        </div>
      </a>
    ))}
  </div>

  <div class="card" style="margin-top:20px;">
    <p style="margin:0;"><strong>Need a full {hub.name} testing panel?</strong> Request datasheets, IFU and OEM/ODM options.</p>
  </div>

</BaseLayout>
