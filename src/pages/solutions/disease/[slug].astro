---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import products from '../../../data/products.json';
import diseaseContent from '../../../data/disease-content.json';
import authorTake from '../../../data/author-take.json';
import faqContent from '../../../data/faq-content.json';

export function getStaticPaths() {
  return products.hubs.map((h) => ({ params: { slug: h.id }, props: { hub: h } }));
}

const { hub } = Astro.props;
const hubProducts = products.products.filter((p) => hub.products.includes(p.id));
const dc = diseaseContent[hub.id];
const at = authorTake[hub.id];
const faqs = faqContent[hub.id] ?? [];
---

<BaseLayout
  title={`${hub.name} Rapid Tests & Testing Guide | Progene Bio`}
  description={`${hub.name} rapid tests and point-of-care testing guide. Products, methods and specimen types from Progene Bio.`}
  canonical={`/solutions/disease/${hub.id}/`}
>

  <p class="breadcrumb"><a href="/">← Home</a></p>
  <h1>{hub.name}</h1>
  <p>Point-of-care rapid testing for {hub.name.toLowerCase()}. OEM/ODM manufacturer.</p>

  {dc && (
    <>
      <h2>Overview</h2>
      <p>{dc.overview}</p>
      <h2>Clinical Context</h2>
      <p>{dc.clinical_context}</p>
      <h2>Diagnostic Markers &amp; Methods</h2>
      <p>{dc.methods}</p>
      <h2>Antigen vs Antibody</h2>
      <p>{dc.antigen_vs_antibody}</p>
      <h2>Diagnostic Workflow</h2>
      <p>{dc.workflow}</p>
      <h2>Testing Window</h2>
      <p>{dc.window}</p>
      <h2>Interpretation</h2>
      <p>{dc.interpretation}</p>
      <h2>False Negative / Positive Considerations</h2>
      <p>{dc.false_considerations}</p>
      <h2>Confirmatory Testing</h2>
      <p>{dc.confirmatory}</p>
      <h2>Testing Settings</h2>
      <p>{dc.settings}</p>
      <h2>Sources</h2>
      <p>{dc.sources}</p>
    </>
  )}

  {at && (
    <div class="card card-accent">
      <h2>The Author's Take</h2>
      <p><strong>Position:</strong> {at.position}</p>
      <ul>
        {at.reasoning.map((r) => <li>{r}</li>)}
      </ul>
      <p style="font-size:.82rem;color:#64748b;">{authorTake._disclosure}</p>
    </div>
  )}

  {faqs.length > 0 && (
    <>
      <h2>Frequently Asked Questions</h2>
      <div class="card">
        {faqs.map((f) => (
          <div style="margin-bottom:12px;">
            <h3 style="margin:0 0 4px; font-size:1rem;">{f.q}</h3>
            <p style="margin:0;">{f.a}</p>
          </div>
        ))}
      </div>
    </>
  )}

  <h2>Products ({hubProducts.length})</h2>
  <div class="product-grid">
    {hubProducts.map((p) => (
      <a class="card product-card" href={`/products/${p.id}/`}>
        <strong>{p.name}</strong>
        <div class="product-meta">{p.target}</div>
        <div class="product-meta">Specimen: {(p.specimen ?? []).join(" / ")}</div>
      </a>
    ))}
  </div>

  <div class="card">
    <p><strong>Need a full {hub.name} testing panel?</strong> Request datasheets, IFU and OEM/ODM options.</p>
  </div>

  {faqs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    })} />
  )}

</BaseLayout>
