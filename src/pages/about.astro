---
import BaseLayout from '../layouts/BaseLayout.astro';

const companyImages = [
  { src: "/images/company-01.webp", width: 1400, height: 1049 },
  { src: "/images/company-02.webp", width: 1400, height: 1049 },
  { src: "/images/company-03.webp", width: 1400, height: 1049 },
  { src: "/images/company-04.webp", width: 1400, height: 1049 },
  { src: "/images/company-05.webp", width: 1400, height: 1050 },
  { src: "/images/company-06.webp", width: 960, height: 1280 },
  { src: "/images/company-07.webp", width: 1280, height: 1706 },
  { src: "/images/company-08.webp", width: 960, height: 1280 },
  { src: "/images/company-09.webp", width: 1400, height: 1050 },
  { src: "/images/company-10.webp", width: 1400, height: 1049 },
  { src: "/images/company-11.webp", width: 1400, height: 1049 },
  { src: "/images/company-12.webp", width: 800, height: 408 },
  { src: "/images/company-13.webp", width: 1400, height: 1049 },
  { src: "/images/company-14.webp", width: 1400, height: 1049 },
  { src: "/images/company-15.webp", width: 1400, height: 1049 },
  { src: "/images/company-16.webp", width: 1400, height: 1050 },
  { src: "/images/company-17.webp", width: 800, height: 478 },
  { src: "/images/company-18.webp", width: 1400, height: 1050 },
  { src: "/images/company-19.webp", width: 1400, height: 1050 },
  { src: "/images/company-20.webp", width: 1400, height: 1050 },
  { src: "/images/company-21.webp", width: 1400, height: 1050 },
].map((image, index) => ({
  ...image,
  alt: `Nanjing Progene Biotechnology manufacturing facility — photo ${index + 1}`,
}));
---

<BaseLayout
  title="About — Nanjing Progene Biotechnology | IVD Manufacturer"
  description="Nanjing Progene Biotechnology Co., Ltd (南京普诺基生物科技有限公司) — IVD rapid test & POCT manufacturer founded 2015, GMP facility in Nanjing. CE, ISO 13485, OEM/ODM."
  canonical="/about/"
>

  <header class="page-hero page-hero--single">
    <div>
      <p class="eyebrow">About Us</p>
      <h1>About Nanjing Progene Biotechnology</h1>
      <p class="lede">
        <strong>南京普诺基生物科技有限公司</strong> (Nanjing Progene Biotechnology Co., Ltd) designs and
        manufactures in-vitro diagnostic (IVD) rapid tests and point-of-care testing (POCT) devices —
        lateral-flow colloidal-gold tests across infectious disease, drug of abuse, cardiac &amp; tumor markers,
        and women's health.
      </p>
    </div>
  </header>

  <section class="gallery-section">
    <h2>Inside the Nanjing Facility</h2>
    <div class="gallery-grid">
      {companyImages.map((image) => (
        <figure>
          <img
            src={image.src}
            width={image.width}
            height={image.height}
            alt={image.alt}
            loading="lazy"
          />
          <figcaption>GMP manufacturing · Nanjing</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <h2>Company Profile</h2>
  <div class="card">
    <table>
      <tbody>
        <tr><th>Legal name (Chinese)</th><td>南京普诺基生物科技有限公司</td></tr>
        <tr><th>Legal name (English)</th><td>Nanjing Progene Biotechnology Co., Ltd</td></tr>
        <tr><th>Founded</th><td>2015</td></tr>
        <tr><th>Address</th><td>No. 26, Hengguang Road, Qixia District, Nanjing, Jiangsu, China</td></tr>
        <tr><th>Manufacturing license</th><td>苏药监械生产许20240173号 (SYJXSCX20240173)</td></tr>
        <tr><th>Export certificate</th><td>苏宁药监械出20252501号 (SNYJXC20252501)</td></tr>
        <tr><th>Facility</th><td>GMP manufacturing facility (Nanjing)</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Technology Platforms</h2>
  <div class="card">
    <p>Progene Bio operates four integrated technology platforms, per its published company profile:</p>
    <ul>
      <li><strong>Core raw materials</strong> — diagnostic antigens, antibodies and reagents developed in-house.</li>
      <li><strong>POCT</strong> — rapid tests across inflammation, cardio-cerebrovascular, hormones, tumor markers and chronic disease.</li>
      <li><strong>Chemiluminescence</strong> — cardio-cerebrovascular, tumor markers, gastric function, thyroid and autoimmune antibodies.</li>
      <li><strong>Molecular diagnostics</strong> — nucleic-acid detection.</li>
    </ul>
    <p>Team origins: affiliated with the Nanjing University laboratory ecosystem.</p>
  </div>

  <h2>Quality Systems &amp; Certifications</h2>
  <div class="card">
    <table>
      <thead><tr><th>Certification</th><th>Status</th></tr></thead>
      <tbody>
        <tr><td>CE Marking (IVDD 98/79/EC)</td><td>Certified lines (self-declaration, Annex III)</td></tr>
        <tr><td>ISO 13485:2016 (GB/T 42061)</td><td>Certified</td></tr>
        <tr><td>FDA 510(k)</td><td>Claimed (no 510(k) number provided)</td></tr>
        <tr><td>NMPA</td><td>Class I filing (第一类医疗器械备案)</td></tr>
      </tbody>
    </table>
    <p class="small muted">
      Certification status reflects the company's published claims; certificate numbers and scope are
      available on request for buyer qualification.
    </p>
  </div>

  <h2>What We Make</h2>
  <p>600+ SKUs across 12 product series, exported to 80+ markets. See the <a href="/products/">product catalog</a>.</p>

  <h2>OEM / ODM</h2>
  <p>
    Private label, custom panels, custom packaging and full kit development — from formulation to
    production-ready SKUs. <a href="/manufacturing/">Learn about manufacturing →</a>
  </p>

  <p class="small muted" style="font-size:.8rem;color:#64748b;">Company profile and technology-platform information verified against third-party IVD industry listings (小桔灯网 iivd.net). Last reviewed: 2026-09-12.</p>

</BaseLayout>
