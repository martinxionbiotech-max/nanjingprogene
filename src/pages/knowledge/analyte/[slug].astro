---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import products from '../../../data/products.json';
import whatIs from '../../../data/what-is-content.json';
import whatIsDoa from '../../../data/what-is-doa.json';
import whatIsClinical from '../../../data/what-is-clinical.json';
import whatIsExtra from '../../../data/what-is-extra.json';

export function getStaticPaths() {
  const allWhatIs = { ...whatIs, ...whatIsDoa, ...whatIsClinical, ...whatIsExtra };
  return Object.entries(allWhatIs).map(([slug, w]) => ({ params: { slug }, props: { slug, w } }));
}

const { slug, w } = Astro.props;
const related = products.products.find((p) => p.id === w.related);
---

<BaseLayout
  title={`What Is ${w.name}? — Marker Explained | Progene Bio`}
  description={`What is ${w.name}? ${w.what}`}
  canonical={`/knowledge/analyte/${slug}/`}
>

  <h1>What Is {w.name}?</h1>

  <div class="card">
    <h2 style="margin-top:0;">What it is</h2>
    <p>{w.what}</p>
    <h2>Why it matters</h2>
    <p>{w.significance}</p>
    {w.specimen && (
      <>
        <h2>Specimen</h2>
        <p>{w.specimen}</p>
      </>
    )}
    {w.cutoff && (
      <>
        <h2>Cut-off</h2>
        <p>{w.cutoff}</p>
      </>
    )}
    {w.interpretation && (
      <>
        <h2>Interpretation</h2>
        <p>{w.interpretation}</p>
      </>
    )}
    {w.limitations && (
      <>
        <h2>Limitations</h2>
        <p>{w.limitations}</p>
      </>
    )}
  </div>

  {related && (
    <div class="card" style="margin-top:16px;">
      <p style="margin:0;">
        <strong>Related test:</strong> <a href={`/products/${related.id}/`}>{related.name}</a>
        {related.specimen?.length ? ` — specimen: ${related.specimen.join(" / ")}` : ""}
      </p>
    </div>
  )}

  {w.faq && w.faq.length > 0 && (
    <div class="card" style="margin-top:16px;">
      <h2 style="margin-top:0;">Frequently Asked Questions</h2>
      {w.faq.map((f) => <p><strong>{f.q}</strong> {f.a}</p>)}
    </div>
  )}

  {w.related_knowledge && w.related_knowledge.length > 0 && (
    <div class="card" style="margin-top:16px;">
      <h2 style="margin-top:0;">Related knowledge</h2>
      <ul style="margin:0;">
        {w.related_knowledge.map((r) => <li><a href={r.href}>{r.title}</a></li>)}
      </ul>
    </div>
  )}

  {w.references && w.references.length > 0 && (
    <>
      <h2>References</h2>
      <ul class="small muted">{w.references.map((r) => <li>{r}</li>)}</ul>
    </>
  )}

  <p style="margin-top:16px;"><a href="/knowledge/">← Knowledge</a></p>

  <p style="font-size:.82rem;color:#64748b;">Last reviewed: 2026-09-12</p>

  {w.faq && w.faq.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": w.faq.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
    })} />
  )}

</BaseLayout>
