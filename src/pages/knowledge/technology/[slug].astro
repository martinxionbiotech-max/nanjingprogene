---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import technologyContent from '../../../data/technology-content.json';

export function getStaticPaths() {
  return Object.entries(technologyContent).map(([slug, t]) => ({ params: { slug }, props: { slug, t } }));
}

const { slug, t } = Astro.props;
---

<BaseLayout
  title={`${t.name} — IVD Technology Explained | Progene Bio`}
  description={`${t.name}: ${t.what}`}
  canonical={`/knowledge/technology/${slug}/`}
>

  <p><a href="/knowledge/">← Knowledge base</a></p>
  <h1>{t.name}</h1>

  <div class="card">
    <h2 style="margin-top:0;">What it is</h2>
    <p>{t.what}</p>
    <h2>How it works</h2>
    <p>{t.how}</p>
    {t.image && (
      <figure style="margin:8px 0 0;">
        <img src={t.image} width="803" height="450" alt={`${t.name} — flow diagram`} loading="lazy" style="width:100%;height:auto;border:1px solid #e5e9f0;border-radius:8px;" />
        <figcaption style="font-size:.82rem;color:#64748b;">How a sample flows through an immunochromatographic test strip.</figcaption>
      </figure>
    )}
    <h2>Why it matters</h2>
    <p>{t.why_matters}</p>
  </div>

  <h2>Key components</h2>
  <ul>
    {t.components.map((c) => <li>{c}</li>)}
  </ul>

  {t.applications && (
    <>
      <h2>Applications</h2>
      <ul>{t.applications.map((a) => <li>{a}</li>)}</ul>
    </>
  )}

  {t.performance_factors && (
    <>
      <h2>What affects performance</h2>
      <ul>{t.performance_factors.map((p) => <li>{p}</li>)}</ul>
    </>
  )}

  {t.limitations && (
    <>
      <h2>Limitations</h2>
      <ul>{t.limitations.map((l) => <li>{l}</li>)}</ul>
    </>
  )}

  {t.faq && t.faq.length > 0 && (
    <>
      <h2>Frequently Asked Questions</h2>
      <div class="card">
        {t.faq.map((f) => <p><strong>{f.q}</strong> {f.a}</p>)}
      </div>
    </>
  )}

  {t.related && (
    <>
      <h2>Related knowledge</h2>
      <ul>{t.related.map((r) => <li><a href={r.href}>{r.title}</a></li>)}</ul>
    </>
  )}

  {t.references && t.references.length > 0 && (
    <>
      <h2>References</h2>
      <ul class="small muted">{t.references.map((r) => <li>{r}</li>)}</ul>
    </>
  )}

  <div class="card" style="margin-top:16px;">
    <p style="margin:0;"><strong>See this technology in our products →</strong> <a href="/products/">Browse catalog</a></p>
  </div>

  <p style="font-size:.82rem;color:#64748b;margin-top:16px;">Written by the Progene Bio Technical Team · Last reviewed: 2026-09-12</p>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TechArticle",
    "headline": t.name,
    "description": t.what
  })} />

  {t.faq && t.faq.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": t.faq.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
    })} />
  )}

</BaseLayout>
