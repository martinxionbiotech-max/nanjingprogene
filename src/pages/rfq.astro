---
import BaseLayout from '../layouts/BaseLayout.astro';
import products from '../data/products.json';
---

<BaseLayout
  title="Request a Quote (RFQ) — Progene Bio IVD Manufacturer"
  description="Request a quotation, sample or OEM/ODM consultation from Nanjing Progene Biotechnology — IVD rapid test manufacturer."
  canonical="/rfq/"
>

  <header class="page-hero page-hero--single">
    <div>
      <p class="eyebrow">RFQ</p>
      <h1>Request a Quote</h1>
      <p class="lede">Our team responds within 24 hours with formulation options, MOQ and pricing.</p>
    </div>
  </header>

  <div class="card">
    <form method="POST" action="/rfq/submit">

      <p><strong>What are you looking for?</strong></p>
      <select name="intent" style="width:100%;padding:8px;">
        <option>Existing product</option>
        <option>Private label (OEM)</option>
        <option>ODM custom panel / formulation</option>
        <option>New assay development</option>
        <option>Distributorship</option>
        <option>Registration support</option>
        <option>Not sure</option>
      </select>

      <p><strong>Product category</strong></p>
      <select name="category" style="width:100%;padding:8px;">
        <option>Infectious disease</option>
        <option>Drug of abuse (DOA)</option>
        <option>Cardiac &amp; tumor markers</option>
        <option>Women's health</option>
        <option>Veterinary</option>
        <option>POCT instrument / FIA</option>
        <option>Other / multiple</option>
      </select>

      <p><strong>Product</strong></p>
      <select name="product" style="width:100%;padding:8px;">
        <option value="">— Select a product (or specify below) —</option>
        {products.products.filter(p => p.priority === "P1").map(p => (
          <option value={p.id}>{p.name}</option>
        ))}
        <option value="other">Other / multiple products</option>
      </select>

      <p><strong>Target analyte / specimen</strong></p>
      <input type="text" name="analyte_specimen" placeholder="e.g., Dengue NS1 — whole blood" style="width:100%;padding:8px;" />

      <p><strong>Test format</strong></p>
      <select name="format" style="width:100%;padding:8px;">
        <option>Cassette</option>
        <option>Strip / Dipstick</option>
        <option>Midstream</option>
        <option>Panel cup</option>
        <option>Device</option>
        <option>Not sure</option>
      </select>

      <p><strong>Buyer type</strong></p>
      <select name="buyer_type" style="width:100%;padding:8px;">
        <option>Distributor</option>
        <option>Laboratory</option>
        <option>Hospital / clinic</option>
        <option>Government / tender</option>
        <option>NGO / aid program</option>
        <option>OEM / private label</option>
      </select>

      <p><strong>Target market</strong></p>
      <select name="market" style="width:100%;padding:8px;margin-bottom:8px;">
        <option>European Union</option>
        <option>Southeast Asia</option>
        <option>Middle East</option>
        <option>Africa</option>
        <option>Latin America</option>
        <option>North America</option>
        <option>Other</option>
      </select>
      <input type="text" name="country" placeholder="Specific country (optional)" style="width:100%;padding:8px;" />

      <p><strong>Certification requirement</strong></p>
      <select name="certification" style="width:100%;padding:8px;">
        <option>CE</option>
        <option>FDA listing / 510(k)</option>
        <option>Other / country registration</option>
        <option>None specified</option>
      </select>

      <p><strong>Private label / packaging</strong></p>
      <select name="private_label" style="width:100%;padding:8px;">
        <option>OEM private label (custom branding)</option>
        <option>ODM custom panel/formulation</option>
        <option>Standard Progene packaging</option>
        <option>Not sure</option>
      </select>

      <p><strong>Documentation needed</strong></p>
      <select name="documentation" style="width:100%;padding:8px;">
        <option>IFU + datasheet</option>
        <option>CE files / technical dossier</option>
        <option>Validation / COA</option>
        <option>Full registration dossier</option>
        <option>Not sure</option>
      </select>

      <p><strong>Estimated annual volume</strong></p>
      <input type="text" name="volume" placeholder="e.g., 10,000 tests/year" style="width:100%;padding:8px;" />

      <p><strong>Your requirements</strong></p>
      <textarea name="message" rows="5" style="width:100%;padding:8px;"
        placeholder="Target analyte, specimen, format, packaging, private label, sample request, MOQ, target price…"></textarea>

      <p><strong>Your contact</strong></p>
      <input type="text" name="name" placeholder="Name" style="width:100%;padding:8px;margin-bottom:8px;" />
      <input type="email" name="email" placeholder="Email" style="width:100%;padding:8px;margin-bottom:8px;" />
      <input type="text" name="company" placeholder="Company" style="width:100%;padding:8px;margin-bottom:12px;" />

      <button class="btn btn-navy" type="submit">Submit RFQ</button>
    </form>
  </div>

</BaseLayout>
