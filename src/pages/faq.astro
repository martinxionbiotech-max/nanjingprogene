    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {"@type":"Question","name":"What products do you manufacture?","acceptedAnswer":{"@type":"Answer","text":"IVD rapid tests and POCT devices — colloidal-gold lateral-flow and fluorescence immunoassay. 600+ SKUs across 12 series: drug of abuse, infectious disease, cardiac and tumor markers, women's health, veterinary and more."}},
      {"@type":"Question","name":"Do you offer OEM / ODM?","acceptedAnswer":{"@type":"Answer","text":"Yes — private label, custom analyte panels, custom cut-offs, packaging and IFU."}},
      {"@type":"Question","name":"What certifications do you hold?","acceptedAnswer":{"@type":"Answer","text":"CE marking (self-declaration under IVDD 98/79/EC), ISO 13485:2016 (GB/T 42061), and China NMPA registration."}},
      {"@type":"Question","name":"What is your MOQ?","acceptedAnswer":{"@type":"Answer","text":"Product-dependent — low MOQ is available on specialty assays. Confirm via RFQ."}},
      {"@type":"Question","name":"Can I request samples?","acceptedAnswer":{"@type":"Answer","text":"Yes — samples are available for evaluation on request."}},
      {"@type":"Question","name":"Do you provide documentation (IFU, datasheet)?","acceptedAnswer":{"@type":"Answer","text":"Yes — IFU, datasheet, validation, COA and CE technical files are available on request."}},
      {"@type":"Question","name":"Do you ship internationally?","acceptedAnswer":{"@type":"Answer","text":"Yes — we export worldwide with full export documentation."}},
      {"@type":"Question","name":"How do I become a distributor?","acceptedAnswer":{"@type":"Answer","text":"Submit an RFQ with your target market and volume — our export team responds within one business day."}}
