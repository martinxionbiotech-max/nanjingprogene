---
import BaseLayout from '../../layouts/BaseLayout.astro';
import products from '../../data/products.json';
---

<BaseLayout title="Product Catalog — IVD Rapid Tests | Progene Bio" description="Full IVD rapid test catalog: 600+ SKUs across 12 series. Infectious disease, drug of abuse, cardiac & tumor markers, women's health." pageType="CollectionPage" crumbName="Product Catalog">

  <header class="page-hero">
    <div>
      <p class="eyebrow">Product Catalog</p>
      <h1>IVD Rapid Tests &amp; POCT Devices</h1>
      <p class="lede">12 series · 600+ SKUs · OEM/ODM private label available.</p>
    </div>
    <figure class="page-hero-media">
      <img
        src="/images/products-11.webp"
        width="1000"
        height="1000"
        alt="Progene Bio rapid diagnostic test product line"
        loading="lazy"
      />
    </figure>
  </header>

  {products.series.map((s) => {
    const seriesProducts = products.products.filter((p) => p.series === s.id);
    return (
      <section class="card">
        <h2><a href={`/products/series/${s.id}/`}>{s.name}</a></h2>
        <p class="muted small">
          {s.sku_count ? `${s.sku_count} SKUs` : `${seriesProducts.length} products`} · {s.method}
        </p>
        <ul class="hub-list">
          {seriesProducts.map((p) => (
            <li><a href={`/products/${p.id}/`}>{p.name}</a></li>
          ))}
        </ul>
      </section>
    );
  })}

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "@id": "https://progenebio.net/products/#catalog",
    "name": "IVD rapid test product catalog",
    "numberOfItems": products.series.length,
    "itemListElement": products.series.map((s, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": s.name,
      "url": `https://progenebio.net/products/series/${s.id}/`
    }))
  })} />

</BaseLayout>
