---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import products from '../../../data/products.json';
import seriesContent from '../../../data/series-content.json';
import authorTakeSeries from '../../../data/author-take-series.json';
import faqSeries from '../../../data/faq-series.json';

export function getStaticPaths() {
  return Object.entries(seriesContent).map(([slug, sc]) => ({ params: { slug }, props: { slug, sc } }));
}

const { slug, sc } = Astro.props;
const seriesMeta = products.series.find((s) => s.id === slug);
const at = authorTakeSeries[slug];
const faqs = faqSeries[slug] ?? [];
const keyProducts = (sc.key_products ?? [])
  .map((id) => products.products.find((p) => p.id === id))
  .filter(Boolean);
const allSeriesProducts = products.products.filter((p) => p.series === slug);
const seriesIndex = products.series.findIndex((s) => s.id === slug);
const seriesImage = `/images/products-${String(((Math.max(0, seriesIndex) % 27) + 1)).padStart(2, "0")}.webp`;
---

<BaseLayout
  title={`${sc.name} — OEM/ODM Manufacturer | Progene Bio`}
  description={`${sc.name}: ${sc.overview}`}
  canonical={`/products/series/${slug}/`}
>

  <p class="breadcrumb"><a href="/products/">← All products</a></p>

  <header class="page-hero">
    <div>
      <p class="eyebrow">Product Series</p>
      <h1>{sc.name}</h1>
      <p class="lede">{sc.overview}</p>
    </div>
    <figure class="page-hero-media">
      <img
        src={seriesImage}
        width="1000"
        height="1000"
        alt={`${sc.name} rapid diagnostic test line — Progene Bio`}
        loading="lazy"
      />
    </figure>
  </header>

  <div class="card">
    <table>
      <tbody>
        <tr><th>SKUs</th><td>{seriesMeta?.sku_count ?? "Expanding"}</td></tr>
        <tr><th>Method</th><td>{seriesMeta?.method ?? "—"}</td></tr>
        <tr><th>OEM/ODM</th><td>Available — private label &amp; custom panels</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Sub-categories</h2>
  <ul>
    {sc.sub_categories.map((c) => <li>{c}</li>)}
  </ul>

  <h2>Key Products ({allSeriesProducts.length})</h2>
  <div class="product-grid">
    {allSeriesProducts.map((p) => (
      <a class="card product-card" href={`/products/${p.id}/`}>
        <strong>{p.name}</strong>
        <div class="product-meta">{p.target}</div>
        <div class="product-meta">Specimen: {(p.specimen ?? []).join(" / ")}</div>
      </a>
    ))}
  </div>

  <h2>Buyer angle</h2>
  <p>{sc.buyer_angle}</p>

  {sc.related_comparisons.length > 0 && (
    <>
      <h2>Related comparisons</h2>
      <ul>
        {sc.related_comparisons.map((c) => (
          <li><a href={`/comparisons/${c.slug}/`}>{c.title}</a></li>
        ))}
      </ul>
    </>
  )}

  {at && (
    <div class="card card-accent">
      <h2>The Author's Take</h2>
      <p><strong>Position:</strong> {at.position}</p>
      <ul>{at.reasoning.map((r) => <li>{r}</li>)}</ul>
      <p class="small muted">Buyer-advisor editorial guidance — not a substitute for product IFU or local regulatory requirements.</p>
    </div>
  )}

  {faqs.length > 0 && (
    <>
      <h2>Frequently Asked Questions</h2>
      <div class="card">
        {faqs.map((f) => (
          <div>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </>
  )}

  <div class="card">
    <p><strong>Need a custom panel or private label?</strong> <a href="/rfq/">Request a quote →</a></p>
  </div>

  <p style="font-size:.82rem;color:#64748b;">Last reviewed: 2026-09-12</p>

</BaseLayout>
