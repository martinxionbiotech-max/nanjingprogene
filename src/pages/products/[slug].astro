---
import BaseLayout from '../../layouts/BaseLayout.astro';
import products from '../../data/products.json';
import skuCatalog from '../../data/sku-catalog.json';
import productContent from '../../data/product-content.json';
import productContentP2 from '../../data/product-content-p2.json';
import productContentP3 from '../../data/product-content-p3.json';
import whatIs from '../../data/what-is-content.json';
import whatIsDoa from '../../data/what-is-doa.json';
import whatIsClinical from '../../data/what-is-clinical.json';
import whatIsExtra from '../../data/what-is-extra.json';
import skuMap from '../../data/product-sku-map.json';

export function getStaticPaths() {
  return products.products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const series = products.series.find((s) => s.id === product.series);
const seriesSkus = skuCatalog[product.series] ?? [];
const content = productContent[product.id] ?? productContentP2[product.id] ?? productContentP3[product.id];
// rough match: SKUs whose product name contains the canonical target keyword
const matchTerms = product.name.replace(/ Rapid Test.*| Test.*| Rapid.*/g, "").trim().split(" ").filter((w) => w.length > 3);
const relatedSkus = seriesSkus.filter((s) => matchTerms.some((t) => s.product.toLowerCase().includes(t.toLowerCase()))).slice(0, 12);
const productIndex = products.products.findIndex((p) => p.id === product.id);
const productImage = `/images/products-${String(((Math.max(0, productIndex) % 27) + 1)).padStart(2, "0")}.webp`;

// schema.org identity + catalog number (only when the catalog match is unambiguous)
const site = "https://progenebio.net";
const productUrl = new URL(`/products/${product.id}/`, site).href;
const productNodeId = productUrl.replace(/\/+$/, "") + "/#product";
const catalogSku = (skuMap as Record<string, string>)[product.id];
const specimenList = (product.specimen ?? []).join(" / ");
const regulatory = product.ce ? "CE (IVDD 98/79/EC)" : "Non-CE / registration in progress";

// Entity graph: product → disease hub / analyte / technology / comparison
const allWhatIs = { ...whatIs, ...whatIsDoa, ...whatIsClinical, ...whatIsExtra };
const analyteEntry = Object.entries(allWhatIs).find(([, w]) => w.related === product.id);
const analyteSlug = analyteEntry?.[0];
const hub = products.hubs.find((h) => h.products.includes(product.id));
const techSlug = product.method === "fluorescence immunoassay" ? "fia" : "lateral-flow";
const comparisonMap = {
  "dengue-ns1": "ns1-vs-pcr", "dengue-igg-igm": "dengue-ns1-vs-igg-igm", "dengue-combo": "dengue-ns1-vs-igg-igm",
  "malaria-pf": "malaria-pf-vs-pan", "malaria-pf-pan": "malaria-pf-vs-pan", "malaria-pf-pv": "malaria-pf-vs-pv",
  "hiv-12": "hiv-vs-syphilis", "syphilis": "hiv-vs-syphilis",
  "hpylori-ag": "hpylori-antigen-vs-antibody", "hpylori-ab": "hpylori-antigen-vs-antibody",
  "troponin-i": "troponin-i-vs-t", "troponin-t": "troponin-i-vs-t",
};
const comparisonSlug = comparisonMap[product.id];
const misconceptions = {
  "doa": "A reactive drug-screen result is presumptive — it does not indicate impairment, timing of use or a diagnosis. Confirm positives by GC-MS/LC-MS.",
  "infectious": "A negative rapid test does not always exclude infection — timing, specimen and pathogen load all matter. Follow up clinically where suspicion is high.",
  "cardiac-tumor": "A single negative troponin does not rule out myocardial infarction — serial testing and clinical context are required. Elevated tumor markers are not diagnostic of cancer.",
  "womens-health": "A negative pregnancy test before a missed period can be false — retest if the period is delayed.",
  "veterinary": "Rapid veterinary tests are screening aids — confirm clinically and interpret with vaccination and exposure history.",
  "other": "An elevated marker is not diagnostic on its own — interpret with clinical context and confirm by reference method.",
};
---

<BaseLayout
  title={`${product.name} — ${series?.name ?? ""} | Progene Bio`}
  description={`${product.name} — detects ${product.target}. ${product.method}. Specimen: ${specimenList}. OEM/ODM IVD manufacturer.`}
  canonical={`/products/${product.id}/`}
  pageType="ItemPage"
  crumbName={product.name}
  breadcrumbs={[
    { name: "Products", href: "/products/" },
    { name: series?.name ?? product.series, href: `/products/series/${product.series}/` },
  ]}
>

  <p class="breadcrumb"><a href="/products/">← All products</a></p>

  <header class="page-hero">
    <div>
      <p class="eyebrow">{series?.name ?? "Rapid Diagnostic Test"}</p>
      <h1>{product.name}</h1>
      <p class="lede">
        Detects {product.target}. {product.method}. Specimen: {(product.specimen ?? []).join(" / ")}.
      </p>
    </div>
    <figure class="page-hero-media">
      <img
        src={productImage}
        width="1000"
        height="1000"
        alt={`${product.name} rapid diagnostic test — Progene Bio`}
        loading="lazy"
      />
    </figure>
  </header>

  <div class="card">
    <table>
      <tbody>
        <tr><th>Target / Analyte</th><td>{product.target}</td></tr>
        <tr><th>Disease / Indication</th><td>{product.disease}</td></tr>
        <tr><th>Series</th><td>{series?.name ?? product.series}</td></tr>
        <tr><th>Method</th><td>{product.method}</td></tr>
        <tr><th>Specimen</th><td>{(product.specimen ?? []).join(" / ")}</td></tr>
        <tr><th>Test time</th><td>Documented in datasheet (typically 10–15 min)</td></tr>
        <tr><th>Storage</th><td>Documented in datasheet (typically 2–30 °C, sealed)</td></tr>
        <tr><th>Shelf life</th><td>Documented in datasheet (typically 24 months)</td></tr>
        <tr><th>Regulatory</th><td>{product.ce ? "CE (IVDD 98/79/EC)" : "Non-CE / registration in progress"}{product.fda ? " · FDA listed" : ""}</td></tr>
        <tr><th>OEM/ODM</th><td>Available — private label &amp; custom panel</td></tr>
      </tbody>
    </table>
  </div>

  <div class="card" style="border-left:4px solid #e8a33d;">
    <h2 style="margin-top:0;">Direct Answer</h2>
    <p>This rapid test detects {product.target} in {(product.specimen ?? []).join(" / ")} to support {product.disease}. It is a {product.method} screening test — a reactive result is presumptive and should be confirmed per the intended use.</p>
  </div>

  {content && (
    <>
      <h2>Intended Use</h2>
      <p>{content.intended_use}</p>

      <h2>Clinical Context</h2>
      <p>{content.clinical_context}</p>

      <h2>Test Principle</h2>
      <p>{productContent.test_principle}</p>

      <h2>Limitations</h2>
      <p>{content.limitations}</p>

      <h2>Procurement</h2>
      <p>{content.procurement}</p>

      <h2>Interpretation</h2>
      <div class="card">
        <table>
          <thead><tr><th>Result</th><th>Lines</th><th>Meaning</th></tr></thead>
          <tbody>
            <tr><th>Positive</th><td>Test + control line</td><td>Target detected (presumptive positive)</td></tr>
            <tr><th>Negative</th><td>Control line only</td><td>Below cut-off / not detected</td></tr>
            <tr><th>Invalid</th><td>No control line</td><td>Repeat with a new device</td></tr>
          </tbody>
        </table>
      </div>

      <h2>Common misconception</h2>
      <p>{misconceptions[product.series] ?? "A reactive result is presumptive — confirm by the appropriate reference method."}</p>

      <h2>Sources</h2>
      <p>Screening results are presumptive, not diagnostic. Confirmatory testing follows WHO, CDC and national regulatory guidance — see <a href="/knowledge/screening-vs-confirmatory/">screening vs confirmatory</a>.</p>
    </>
  )}

  {relatedSkus.length > 0 && (
    <>
      <h2>Available SKUs (this series)</h2>
      <div class="card">
        <table>
          <thead><tr><th>Cat. No.</th><th>Product</th><th>Specimen</th><th>Format</th><th>Kit Size</th><th>Status</th></tr></thead>
          <tbody>
            {relatedSkus.map((s) => (
              <tr>
                <td>{s.cat_no}</td>
                <td>{s.product}</td>
                <td>{s.specimen}</td>
                <td>{s.format}</td>
                <td>{s.kit_size}</td>
                <td>{s.status}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <div class="card">
    <h2>Technical Evidence</h2>
    <table>
      <tbody>
        <tr><th>Analytical performance</th><td>Sensitivity, specificity, cut-off and precision are documented per product line in the datasheet and validation report.</td></tr>
        <tr><th>Average accuracy</th><td>≥96% (overall agreement rate, manufacturer-validated). Per-product sensitivity and specificity are documented in the datasheet.</td></tr>
        <tr><th>Clinical performance</th><td>Evaluation data (study population, reference method, agreement) available on request.</td></tr>
        <tr><th>Cross-reactivity</th><td>Documented per analyte — see limitations above.</td></tr>
        <tr><th>Documents</th><td>IFU · Datasheet · Certificate · Declaration of Conformity — request below.</td></tr>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2>Buyer Information</h2>
    <table>
      <tbody>
        <tr><th>MOQ</th><td>Product-dependent — low MOQ available on specialty assays</td></tr>
        <tr><th>OEM / private label</th><td>Custom branding, cut-off, panel and packaging</td></tr>
        <tr><th>Samples</th><td>Available for evaluation — request via RFQ</td></tr>
        <tr><th>Lead time</th><td>On request</td></tr>
        <tr><th>Documents</th><td>IFU · Datasheet · COA · Validation report · CE files · Registration support</td></tr>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2>Related knowledge</h2>
    <ul style="margin:0;">
      {hub && <li><a href={`/solutions/disease/${hub.id}/`}>Disease: {hub.name}</a></li>}
      {analyteEntry && <li><a href={`/knowledge/analyte/${analyteSlug}/`}>Analyte: {analyteEntry[1].name}</a></li>}
      <li><a href={`/knowledge/technology/${techSlug}/`}>Technology: {techSlug === "fia" ? "Fluorescence immunoassay" : "Colloidal gold lateral flow"}</a></li>
      {comparisonSlug && <li><a href={`/comparisons/${comparisonSlug}/`}>Comparison guide</a></li>}
      <li><a href="/oem/">OEM / ODM solution</a></li>
    </ul>
  </div>

  <div class="card">
    <p><strong>Documentation &amp; quotation</strong> — datasheet, IFU, certificate, MOQ and OEM/ODM options on request.</p>
    <p style="margin:10px 0 0;">
      <a class="btn" href="/rfq/">Request IFU / Spec Sheet</a>
      <a class="btn" href="/rfq/" style="margin-left:8px;">Request Datasheet</a>
      <a class="btn" href="/rfq/" style="margin-left:8px;">Request Certificate</a>
    </p>
  </div>

  <p style="font-size:.82rem;color:#64748b;">Last reviewed: 2026-09-12</p>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": productNodeId,
    "name": product.name,
    "url": productUrl,
    "description": `Rapid immunochromatographic test for ${product.target}, used in the assessment of ${product.disease}. ${product.method}. Specimen: ${specimenList}.`,
    "image": [new URL(productImage, site).href],
    "category": series?.name ?? product.series,
    "brand": { "@type": "Brand", "@id": site + "/#brand", "name": "Progene Bio" },
    "manufacturer": { "@id": site + "/#organization" },
    "mainEntityOfPage": { "@id": productUrl.replace(/\/+$/, "") + "/#webpage" },
    "audience": {
      "@type": "BusinessAudience",
      "audienceType": "IVD distributors, clinical laboratories, public-health programmes and OEM/ODM buyers"
    },
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "Method", "value": product.method },
      { "@type": "PropertyValue", "name": "Specimen", "value": specimenList },
      { "@type": "PropertyValue", "name": "Target / analyte", "value": product.target },
      { "@type": "PropertyValue", "name": "Regulatory status", "value": regulatory },
      { "@type": "PropertyValue", "name": "OEM / ODM", "value": "Available — private label and custom panels" },
      { "@type": "PropertyValue", "name": "Supply model", "value": "Quotation-based B2B supply — MOQ, price and lead time on request" }
    ],
    ...(catalogSku ? { "sku": catalogSku } : {}),
    "offers": {
      "@type": "Offer",
      "@id": productUrl.replace(/\/+$/, "") + "/#offer",
      "url": site + "/rfq/",
      "availability": "https://schema.org/InStock",
      "itemCondition": "https://schema.org/NewCondition",
      "businessFunction": "http://purl.org/goodrelations/v1#Sell",
      "seller": { "@id": site + "/#organization" }
    }
  })} />

</BaseLayout>
