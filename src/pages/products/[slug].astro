---
import BaseLayout from '../../layouts/BaseLayout.astro';
import products from '../../data/products.json';
import skuCatalog from '../../data/sku-catalog.json';
import productContent from '../../data/product-content.json';
import productContentP2 from '../../data/product-content-p2.json';
import productContentP3 from '../../data/product-content-p3.json';

export function getStaticPaths() {
  return products.products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const series = products.series.find((s) => s.id === product.series);
const seriesSkus = skuCatalog[product.series] ?? [];
const content = productContent[product.id] ?? productContentP2[product.id] ?? productContentP3[product.id];
// rough match: SKUs whose product name contains the canonical target keyword
const matchTerms = product.name.replace(/ Rapid Test.*| Test.*| Rapid.*/g, "").trim().split(" ").filter((w) => w.length > 3);
const relatedSkus = seriesSkus.filter((s) => matchTerms.some((t) => s.product.toLowerCase().includes(t.toLowerCase()))).slice(0, 12);
const productIndex = products.products.findIndex((p) => p.id === product.id);
const productImage = `/images/products-${String(((Math.max(0, productIndex) % 27) + 1)).padStart(2, "0")}.webp`;
---

<BaseLayout
  title={`${product.name} — ${series?.name ?? ""} | Progene Bio`}
  description={`${product.name} — detects ${product.target}. ${product.method}. Specimen: ${(product.specimen ?? []).join("/")}. OEM/ODM IVD manufacturer.`}
  canonical={`/products/${product.id}/`}
>

  <p class="breadcrumb"><a href="/products/">← All products</a></p>

  <header class="page-hero">
    <div>
      <p class="eyebrow">{series?.name ?? "Rapid Diagnostic Test"}</p>
      <h1>{product.name}</h1>
      <p class="lede">
        Detects {product.target}. {product.method}. Specimen: {(product.specimen ?? []).join(" / ")}.
      </p>
    </div>
    <figure class="page-hero-media">
      <img
        src={productImage}
        width="1000"
        height="1000"
        alt={`${product.name} rapid diagnostic test — Progene Bio`}
        loading="lazy"
      />
    </figure>
  </header>

  <div class="card">
    <table>
      <tbody>
        <tr><th>Target / Analyte</th><td>{product.target}</td></tr>
        <tr><th>Disease / Indication</th><td>{product.disease}</td></tr>
        <tr><th>Series</th><td>{series?.name ?? product.series}</td></tr>
        <tr><th>Method</th><td>{product.method}</td></tr>
        <tr><th>Specimen</th><td>{(product.specimen ?? []).join(" / ")}</td></tr>
        <tr><th>Regulatory</th><td>{product.ce ? "CE (IVDD 98/79/EC)" : "Non-CE / registration in progress"}{product.fda ? " · FDA: available on request" : ""}</td></tr>
        <tr><th>OEM/ODM</th><td>Available — private label &amp; custom panel</td></tr>
      </tbody>
    </table>
  </div>

  <div class="card" style="border-left:4px solid #e8a33d;">
    <h2 style="margin-top:0;">Direct Answer</h2>
    <p>This rapid test detects {product.target} in {(product.specimen ?? []).join(" / ")} to support {product.disease}. It is a {product.method} screening test — a reactive result is presumptive and should be confirmed per the intended use.</p>
  </div>

  {content && (
    <>
      <h2>Intended Use</h2>
      <p>{content.intended_use}</p>

      <h2>Clinical Context</h2>
      <p>{content.clinical_context}</p>

      <h2>Test Principle</h2>
      <p>{productContent.test_principle}</p>

      <h2>Limitations</h2>
      <p>{content.limitations}</p>

      <h2>Procurement</h2>
      <p>{content.procurement}</p>

      <h2>Interpretation</h2>
      <div class="card">
        <table>
          <thead><tr><th>Result</th><th>Lines</th><th>Meaning</th></tr></thead>
          <tbody>
            <tr><th>Positive</th><td>Test + control line</td><td>Target detected (presumptive positive)</td></tr>
            <tr><th>Negative</th><td>Control line only</td><td>Below cut-off / not detected</td></tr>
            <tr><th>Invalid</th><td>No control line</td><td>Repeat with a new device</td></tr>
          </tbody>
        </table>
      </div>
    </>
  )}

  {relatedSkus.length > 0 && (
    <>
      <h2>Available SKUs (this series)</h2>
      <div class="card">
        <table>
          <thead><tr><th>Cat. No.</th><th>Product</th><th>Specimen</th><th>Format</th><th>Kit Size</th><th>Status</th></tr></thead>
          <tbody>
            {relatedSkus.map((s) => (
              <tr>
                <td>{s.cat_no}</td>
                <td>{s.product}</td>
                <td>{s.specimen}</td>
                <td>{s.format}</td>
                <td>{s.kit_size}</td>
                <td>{s.status}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <div class="card">
    <p><strong>Documentation &amp; quotation</strong> — datasheet, IFU, MOQ and OEM/ODM options on request.</p>
    <p style="margin:10px 0 0;">
      <a class="btn" href="/rfq/">Request IFU / Spec Sheet</a>
      <a class="btn" href="/rfq/" style="margin-left:8px;">Request Datasheet</a>
    </p>
  </div>

  <p style="font-size:.82rem;color:#64748b;">Last reviewed: 2026-09-12</p>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "description": `Rapid test for ${product.target}. ${product.method}.`,
    "category": series?.name ?? product.series,
    "brand": { "@type": "Brand", "name": "Progene Bio" },
    "manufacturer": { "@type": "Organization", "name": "Nanjing Progene Biotechnology Co., Ltd" }
  })} />

</BaseLayout>
